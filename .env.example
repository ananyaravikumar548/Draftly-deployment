# MongoDB connection. Use a persistent, network-restricted database for deployment.
MONGODB_URI=mongodb://127.0.0.1:27017/careerflow
MONGODB_DATABASE=careerflow

# Required for job analysis. Keep credentials server-side and out of browser variables.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
ANALYZE_DAILY_LIMIT=10

# Optional Gmail OAuth integration. Set the redirect URI to
# https://<your-domain>/api/gmail/callback when enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
