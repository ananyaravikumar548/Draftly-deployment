# Local single-user database. MongoDB Community Server listens here by default.
MONGODB_URI=mongodb://127.0.0.1:27017/careerflow
MONGODB_DATABASE=careerflow

# Add your Groq key to .env.local. Never expose it to browser code or commit it.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
DEMO_FIXTURES=true
